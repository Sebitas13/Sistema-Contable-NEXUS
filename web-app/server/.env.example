# ==========================================================================
# Variables de entorno del BACKEND Node (web-app/server).
# Copiar a .env y completar. NO subir el .env real al repo.
# ==========================================================================

# --- Base de datos Turso (libSQL) ---
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=tu_token_turso

# --- Motor IA (FastAPI en Render) ---
AI_ENGINE_URL=https://tu-motor-ai.onrender.com

# --- Seguridad: contraseña única de acceso ---
# Si se define, la app exige login (recomendado en producción).
# Vacío = app abierta sin login (solo para desarrollo).
# El mismo valor debe configurarse en el motor Python (APP_PASSWORD) para que
# sus callbacks al backend funcionen con la auth activa.
APP_PASSWORD=

# --- CORS ---
# Origen del frontend permitido en producción (la URL de Vercel).
FRONTEND_ORIGIN=https://tu-frontend.vercel.app

# Activar CORS dinámico y comportamiento de producción.
# NODE_ENV=production
# USE_DYNAMIC_CORS=true

# Puerto (Render lo inyecta automáticamente).
# PORT=3001
