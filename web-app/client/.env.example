# ==========================================================================
# Variables de entorno del FRONTEND (web-app/client). Prefijo VITE_ obligatorio.
# Copiar a .env y completar. En producción se configuran en Vercel.
# ==========================================================================

# URL del backend Node.
#   - Desarrollo local: http://localhost:3001
#   - Producción: la URL del backend en Render (o vacío si se usa el proxy de Vercel)
VITE_API_URL=http://localhost:3001

# (Opcional) URL directa del motor IA. Normalmente NO se usa: el frontend
# llama al motor a través del backend Node.
VITE_AI_ENGINE_URL=
VITE_AI_ENGINE_URL_ALT=
