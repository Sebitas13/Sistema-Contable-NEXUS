# ==========================================================================
# Variables de entorno (RAÍZ) — usadas por el motor Python y scripts locales.
# Copiar a .env y completar. NO subir el .env real al repo.
# ==========================================================================

# --- Groq API (LLM del asistente / enriquecimiento) ---
AI_BACKEND=llm
LLM_ENDPOINT=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=gsk_tu_api_key

# --- Mahoraga ---
MAHORAGA_MODE=manual

# --- Seguridad ---
# Contraseña única de acceso. Debe coincidir con la del backend Node.
# El motor Python la usa para autenticar sus callbacks al backend.
APP_PASSWORD=
